{
  "name": "nextcrest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "webhook": "node server/webhook/server.ts",
    "sync:smartercontact": "node --env-file=.env server/sync/smartercontact-sync.ts",
    "sync:smartercontact:daily": "npm run sync:smartercontact -- --inbox && npm run sync:smartercontact -- --inbox-details=500 && npm run sync:smartercontact -- --inbox-messages=200 && npm run sync:smartercontact -- --inbox-labels=2000",
    "sync:landportal-orders": "node --env-file=.env server/sync/landportal-orders.ts",
    "test:db": "node tests/db/merge_check.mjs && node tests/db/sc_check.mjs && node tests/db/discard_check.mjs && node tests/db/zip_check.mjs && node tests/db/sync_check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
